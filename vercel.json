{
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "https://api.trendbuzzs.com/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.trendbuzzs.com/sitemap.xml"
    },
